# Sem configuração, usa SQLite local e gera uma chave JWT em .jwt_secret.
# DATABASE_URL=sqlite:///estacionamento.db
# JWT_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256

# MySQL existente: instale requirements-mysql.txt e configure estes campos.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=seu_usuario
# MYSQL_PASSWORD=sua_senha
# MYSQL_DATABASE=seu_banco

# Túnel SSH opcional para acessar o MySQL.
# SSH_HOST=seu_servidor
# SSH_PORT=22
# SSH_USER=seu_usuario
# SSH_PASSWORD=sua_senha
